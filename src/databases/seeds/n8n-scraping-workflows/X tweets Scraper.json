      "parameters": {
        "jsCode": "console.log(\"Input item structure:\", JSON.stringify($input.item, null, 2));\n\nfunction formatDate(dateString) {\n  if (!dateString) return '';\n  \n  try {\n    const date = new Date(dateString);\n    // Format: \"March 13, 2025 at 19:25\"\n    return date.toLocaleString('en-US', {\n      year: 'numeric',\n      month: 'long',\n      day: 'numeric',\n      hour: '2-digit',\n      minute: '2-digit'\n    });\n  } catch (error) {\n    console.log(\"Error formatting date:\", error);\n    return dateString; // Return original if parsing fails\n  }\n}\n\n// Check if this is a Twitter Search result with multiple tweets\nif ($input.item.json.tweets && Array.isArray($input.item.json.tweets) && $input.item.json.tweets.length > 0) {\n  const items = $input.item.json.tweets.map(tweet => {\n    const author = tweet.author;\n    return {\n      json: {\n        userId: author.id || '',\n        url: author.url || '',\n        user_name: author.userName || '',\n        name: author.name || '',\n        is_verified: author.isBlueVerified || '',\n        avatar_url: author.profilePicture || '',\n        cover_url: author.coverPicture || '',\n        description: author.description || '',\n        location: author.location || '',\n        followers: author.followers || 0,\n        following: author.following || 0,\n        bio_description: author.profile_bio?.description || '',\n        created_at: formatDate(author.createdAt)\n      }\n    };\n  });\n  \n  console.log(`Processing ${items.length} tweets`);\n  \n  // Return all items\n  return items;\n} else {\n  // This is a single tweet, just extract and return its data\n  const item = $input.item.json;\n  const author = item.author\n\n  const tweetData = {\n    userId: author.id || '',\n    url: author.url || '',\n    user_name: author.userName || '',\n    name: author.name || '',\n    is_verified: author.isBlueVerified || 'FALSE',\n    avatar_url: author.profilePicture || '',\n    cover_url: author.coverPicture || '',\n    description: author.description || '',\n    location: author.location || '',\n    followers: author.followers || 0,\n    following: author.following || 0,\n    bio_description: author.profile_bio?.description || '',\n    created_at: formatDate(author.createdAt)\n  };\n  \n  console.log(\"Processing single tweet\");\n  \n  // Return as a single item\n  return {\n    json: tweetData\n  };\n}"
