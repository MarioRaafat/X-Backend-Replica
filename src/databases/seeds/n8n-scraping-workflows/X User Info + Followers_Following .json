    {
      "parameters": {
        "jsCode": "const allUsers = [];\n\nfor (const item of $input.all()) {\n  const users = item.json.users || [];\n  allUsers.push(...users);\n}\n\nif (allUsers.length === 0) {\n  return [];\n}\n\nreturn allUsers.map(user => ({\n  json: {\n    userId: user.id || '',\n    userName: user.userName || '',\n    url: user.url || '',\n    name: user.name || '',\n    isBlueVerified: user.isBlueVerified || false,\n    verifiedType: user.verifiedType || '',\n    profilePicture: user.profilePicture || '',\n    coverPicture: user.coverPicture || '',\n    description: user.description || '',\n    location: user.location || '',\n    followers: user.followers || 0,\n    following: user.following || 0,\n    canDm: user.canDm || false,\n    createdAt: user.createdAt || '',\n    favouritesCount: user.favouritesCount || 0,\n    hasCustomTimelines: user.hasCustomTimelines || false,\n    isTranslator: user.isTranslator || false,\n    mediaCount: user.mediaCount || 0,\n    statusesCount: user.statusesCount || 0\n  }\n}));"
      },
