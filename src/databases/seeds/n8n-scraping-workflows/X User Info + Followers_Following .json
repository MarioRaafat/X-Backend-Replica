    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\n\n// Extract unique author IDs\nconst authorIds = allItems\n  .map(item => item.json.authorId)\n  .filter(id => id && id !== '');\n\nconst uniqueIds = [...new Set(authorIds)];\n\nconsole.log(`Total unique author IDs: ${uniqueIds.length}`);\n\n// Create batches of 25 users (reduced to avoid rate limits)\nconst batchSize = 25;\nconst batches = [];\n\nfor (let i = 0; i < uniqueIds.length; i += batchSize) {\n  const batch = uniqueIds.slice(i, i + batchSize);\n  batches.push({\n    json: {\n      userIds: batch.join(','),\n      userIdsArray: batch,\n      batchNumber: Math.floor(i / batchSize) + 1,\n      totalBatches: Math.ceil(uniqueIds.length / batchSize)\n    }\n  });\n}\n\nconsole.log(`Created ${batches.length} batches`);\nreturn batches;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
