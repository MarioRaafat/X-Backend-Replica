    {
      "parameters": {
        "jsCode": "const allTweets = [];\nlet i =0;\nfor (const item of $input.all()) {\n  i++;\n  if (i < 0) {\n    continue;\n  }\n  if (item.json.replyCount) {\n    allTweets.push(item.json);\n  } \n}\n\nif (allTweets.length === 0) {\n  return [];\n}\n\n// ---- Take 40% of the tweets (rounded down) ----\nconst fortyPercentCount = Math.floor(allTweets.length * 0.6);\nconst sample = allTweets.slice(0, fortyPercentCount);\n// ----------------------------------------------\n\nreturn sample.map(tweet => ({\n  json: {\n    tweetId: tweet.tweetId || '',\n  }\n}));"
      },
